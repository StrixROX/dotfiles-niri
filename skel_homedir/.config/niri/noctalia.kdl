layout {

    focus-ring {
        active-color   "#d567e4"
        inactive-color "#27132a"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#d567e4"
        inactive-color "#27132a"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#d567e4"
        inactive-color "#771485"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#d567e480"
    }
}

recent-windows {
    highlight {
        active-color "#d567e4"
        urgent-color "#fd4663"
    }
}
