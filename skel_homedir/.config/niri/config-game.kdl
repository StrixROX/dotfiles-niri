include "myconfigs/binds.kdl"
include "myconfigs/input.kdl"
include "myconfigs/layout.kdl"
include "myconfigs/misc.kdl"

window-rule {
    match app-id=r#"pavucontrol"#
    default-window-height { proportion 0.5; }
    max-height 480
    open-floating true
    default-floating-position x=0 y=300 relative-to="top"
}

include "noctalia.kdl"
