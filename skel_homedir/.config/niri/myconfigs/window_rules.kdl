// workspace-agnostic rules
window-rule {
    match app-id="^kitty$"
    match app-id="Nautilus"
    match app-id="shelly$"
    match app-id="^GParted$"
    match app-id="^org.gnome.DiskUtility$"
    open-floating true
    default-column-width { proportion 0.7; }
    default-window-height { proportion 0.66; }
}

window-rule {
    match title="^Proton VPN$"
    open-floating true
    default-floating-position x=200 y=0 relative-to="right"
}

window-rule {
    match title="Calculator"
    open-floating true
    default-column-width { fixed 360; }
    default-window-height { fixed 616; }
    default-floating-position x=250 y=0 relative-to="right"
}

window-rule {
    match app-id="^PPSSPPSDL$"
    open-fullscreen true
}

window-rule {
    match app-id="nvim:mynotes.txt"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="^microsoft-edge$"
    match app-id="^Mullvad Browser$"
    match app-id="^chromium$"

    open-maximized true

    popups {
        opacity 1.0
    }
}

window-rule {
    match app-id="^steam$"
    open-floating true
    default-column-width { proportion 0.8; }
    default-window-height { proportion 0.8; }

    popups {
        opacity 1.0
    }
}

window-rule {
    match app-id="^steam$" title="^Steam Big Picture Mode$"
    open-fullscreen true
}

window-rule {
    match app-id="KeePassXC"
    open-floating true
    default-column-width { fixed 700; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id=r"pavucontrol"
    max-height 480
    open-floating true
    default-floating-position x=0 y=300 relative-to="top"
}

window-rule {
    match app-id=r"^steam$" title=r"^notificationtoasts_\d+_desktop$"
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

window-rule {
    match title="Picture in picture" // browser PiPs

    open-floating true
    open-focused false

    min-width 400
    min-height 225
    default-column-width { proportion 0.25; }
    default-window-height { proportion 0.25; }
    default-floating-position x=24 y=24 relative-to="bottom-right"

    focus-ring { off; }
    shadow {
        on
        softness 40
        spread 2
        offset x=0 y=0
        draw-behind-window false
        color "#00000064"
    }
}



// top workspace (apps-bg)
window-rule {
    // web apps
    match title="WhatsApp"
    match title="YouTube Music"
    match title="Gmail"
    match title="TutaMail"

    // apps
    match app-id=".hermes$" title="Hermes"
    match app-id="^com.anthropic.Claude$"
    match app-id="^ai.elementlabs.lmstudio$"
    match app-id="sidra"

    open-maximized true
    open-focused true
    open-on-workspace "apps-bg"
}



// middle workspace (default)
//
// --- N/A ---
//


// bottom workspace (apps-other)
window-rule {
    match title="Figma" // web app

    open-maximized true
    open-focused true
    open-on-workspace "apps-other"

    opacity 1.0
}

window-rule {
    // web app
    match title="onshape"

    // app
    match app-id="^BambuStudio$"

    open-maximized true
    open-focused true
    open-on-workspace "apps-other"
}

